# ------------------------------------------------------------
# Blackbird Honduras - DEVELOPMENT ONLY
# Copy this file to .env.local. Never commit real credentials.
# ------------------------------------------------------------

# App
NEXT_PUBLIC_APP_NAME="Blackbird Honduras"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase Auth / Data API (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# PostgreSQL runtime connection.
# In hosted/serverless environments this can point to Supabase's pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require"

# Direct PostgreSQL connection used ONLY for migrations / schema administration.
# Keep this server-side. Never prefix it with NEXT_PUBLIC_.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
